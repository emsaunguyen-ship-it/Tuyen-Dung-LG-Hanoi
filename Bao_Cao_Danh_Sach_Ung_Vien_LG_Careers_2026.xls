    .info-table { margin-bottom: 20px; font-size: 13px; }
    .info-label { font-weight: bold; color: #555555; width: 180px; }
    th { background-color: #A50034; color: #ffffff; font-weight: bold; border: 1px solid #7B0027; padding: 10px; text-align: center; font-size: 13px; }
    td { border: 1px solid #cbd5e1; padding: 8px; font-size: 12.5px; vertical-align: middle; }
    tr:nth-child(even) { background-color: #f8fafc; }
    .status-pending { background-color: #fef3c7; color: #92400e; font-weight: bold; text-align: center; border-radius: 12px; padding: 4px 8px; }
    .status-shortlisted { background-color: #dcfce7; color: #166534; font-weight: bold; text-align: center; border-radius: 12px; padding: 4px 8px; }
    .audit-badge { color: #A50034; font-weight: bold; }
  </style>
</head>
